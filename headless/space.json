{
  "_about": "Ranges for `explore`. Each key is a rule path from `node headless/cli.js rules`; * matches several rules, which then share one sampled value. range = absolute [min, max]; scale = multiply the defaults by a factor in [min, max]; int rounds; log samples evenly in ratio rather than difference.",
  "startCash":             { "range": [30000, 120000], "int": true },
  "start.workers":         { "range": [1, 3], "int": true },
  "start.demand":          { "range": [0, 0.8] },
  "start.till":            { "range": [0, 1], "int": true },
  "start.pickup":          { "range": [0, 1], "int": true },
  "start.brewer":          { "range": [0, 1], "int": true },
  "start.espresso":        { "range": [0, 1], "int": true, "with": { "start.grinder": "same" } },
  "wagePerMin":            { "range": [5, 20], "int": true },
  "hireCost":              { "range": [2000, 15000], "int": true },
  "orderTime":             { "range": [20, 90], "int": true },
  "products.*.make":       { "scale": [0.3, 1.2], "int": true },
  "products.*.price":      { "scale": [0.8, 1.5], "int": true },
  "items.*.cost":          { "scale": [0.3, 1.2], "int": true },
  "items.*.buildMins":     { "scale": [0.4, 1.5], "int": true },
  "items.*.slots":         { "range": [2, 8], "int": true },
  "demand.base":           { "range": [6, 30], "log": true },
  "demand.gain":           { "range": [0.005, 0.06], "log": true },
  "demand.growAt":         { "range": [0.35, 0.65] },
  "mix.espresso":          { "range": [20, 70], "int": true },
  "fit.1":                 { "range": [0.4, 0.9] },
  "patience.min":          { "range": [600, 2400], "int": true },
  "start.sacks":           { "range": [0, 6], "int": true },
  "supply.sackCost":       { "range": [300, 1200], "int": true },
  "supply.leadMins":       { "range": [5, 60], "int": true },
  "items.*.hopper":        { "scale": [0.5, 2], "int": true },
  "items.*.knock":         { "scale": [0.4, 2], "int": true },
  "research.rate":         { "range": [4, 30], "int": true },
  "research.topics.*.work": { "scale": [0, 2], "int": true }
}
